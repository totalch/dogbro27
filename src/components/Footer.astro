---
import Logo from "./Logo.astro";

const columns = [
	{
		heading: "Services",
		links: [
			{ href: "/#services", label: "AI Content Generation" },
			{ href: "/#services", label: "Data Scraping & Insights" },
			{ href: "/#services", label: "AI Support Bots" },
			{ href: "/#services", label: "UI/UX Prototyping" },
		],
	},
	{
		heading: "Resources",
		links: [
			{ href: "/search", label: "Search" },
			{ href: "/#faq", label: "FAQ" },
			{ href: "/blog", label: "Blog" },
			{ href: "/rss.xml", label: "RSS" },
		],
	},
	{
		heading: "Company",
		links: [
			{ href: "#", label: "About" },
			{ href: "#", label: "Careers" },
			{ href: "mailto:sales@dogbro.store", label: "Contact" },
			{ href: "https://github.com/totalch/dogbro27", label: "GitHub" },
		],
	},
];
---

<footer class="bg-ink text-sky-mist">
	<div
		class="mx-auto grid max-w-[1200px] gap-8 px-8 pt-[60px] pb-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]"
	>
		<div>
			<Logo size="sm" />
			<p class="mt-4 max-w-[260px] text-sm leading-relaxed text-slate-400">
				Dogbro LLC builds tailored AI and automation solutions that help businesses scale operations, cut overhead, and uncover market opportunities.
			</p>
			<div class="mt-4 flex gap-3">
				<img src="/logos/logo-horizontal-light.svg" alt="Dogbro LLC" class="h-[28px] w-auto" />
			</div>
		</div>
		{
			columns.map((col) => (
				<div>
					<div class="mb-3.5 text-sm font-bold text-cloud">{col.heading}</div>
					<div class="flex flex-col gap-2.5 text-sm">
						{col.links.map((link) => (
							<a href={link.href} class="text-sky-mist hover:text-orange">
								{link.label}
							</a>
						))}
					</div>
				</div>
			))
		}
	</div>
	<div class="border-t border-white/10">
		<div
			class="mx-auto flex max-w-[1200px] flex-wrap justify-between gap-3 px-8 py-5 text-[13px] text-slate-500"
		>
			<span>© 2026 Dogbro LLC. All rights reserved.</span>
			<span>
				Questions? <a href="mailto:sales@dogbro.store" class="hover:text-orange">sales@dogbro.store</a>
			</span>
		</div>
	</div>
</footer>
